# ─────────────────────────────────────────────────────────────────────────────
# Stitch Debt Recovery Pulse — environment contract
#
#   cp .env.example .env   and fill in the blanks.
#
# Committed on purpose: it documents every variable the stack reads. NEVER put a
# real secret in this file — .gitignore excludes .env but deliberately keeps
# this one tracked. .dockerignore keeps .env out of every image; the values
# reach the container at runtime via env_file / the deployment environment.
#
# Sections:
#   1. REQUIRED  — the app container will not work correctly without these
#   2. OPTIONAL  — sensible defaults; override only when needed
#   3. LEGACY    — direct Zoho Sheet ETL (Dockerfile.etl). Rollback only; NOT
#                  started by docker-compose.yml. Zoho Flow is the live
#                  ingestion path — never run both.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. REQUIRED (app)
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# All five tables (collections_messages, emp_details, dossier, lenders, bucket)
# must live in this ONE schema — every query uses unqualified table names.
# DB_HOST is the production MySQL host as seen FROM THE CONTAINER. Do not use
# 127.0.0.1/localhost there: inside a container that is the container itself.
# If a variable is left unset, server.ts falls back to a local development
# default (localhost / root / 1234 / c_green) — never rely on that in production.
DB_HOST=<production-mysql-host>
DB_PORT=3306
DB_USER=<app-db-user>
DB_PASSWORD=<app-db-password>
DB_NAME=c_green
# Leave UNSET in containers. A non-empty socket path makes mysql2 ignore
# DB_HOST/DB_PORT entirely; it defaults on only for local macOS development.
# DB_SOCKET_PATH=/private/tmp/mysql.sock

# ── Zoho Flow collection webhook ────────────────────────────────────────────
# Authenticates POST /api/integrations/zoho/collections
# (production: https://collections.dashboard.cgreen.in/api/integrations/zoho/collections).
# Generate a long random value, store it in the deployment secret manager, and
# set the same value in Zoho Flow as:  Authorization: Bearer <secret>
# Unset ⇒ the endpoint answers 503 and no collections are ingested.
ZOHO_FLOW_WEBHOOK_SECRET=

# ── App server ──────────────────────────────────────────────────────────────
# docker-compose.yml pins PORT=3001 and NODE_ENV=production inside the
# container; these lines matter when running without compose.
NODE_ENV=production
PORT=3001
# Daily/monthly KPI boundaries are computed in LOCAL time. A UTC container
# shifts the business day, so this is not cosmetic.
TZ=Asia/Kolkata


# ═════════════════════════════════════════════════════════════════════════════
# 2. OPTIONAL (app)
# ═════════════════════════════════════════════════════════════════════════════

# Host port compose publishes the container's port 3001 on (reverse proxy target).
APP_PORT=3001
# Per connected SSE client, so raising the client count multiplies query load.
DASHBOARD_STREAM_POLL_MS=2000
# Webhook request body limit. Small by design: one sheet row per request.
# ZOHO_FLOW_MAX_BODY_BYTES=64kb

# ── Employee photos ─────────────────────────────────────────────────────────
# Google Admin Directory lookup (paths inside the container; the files are
# mounted by docker-compose.yml, never baked into the image). If the org has
# left Google Workspace, leave these unset: the dashboard falls back to
# initials, and dropping image files into public/employee-photos/ (named
# <email with non-alphanumerics as _>.jpg) takes priority over the API.
GOOGLE_PHOTOS_CREDENTIALS=credentials1.json
GOOGLE_PHOTOS_TOKEN=token1.json
# GOOGLE_PHOTO_CACHE_TTL_MS=21600000
# GOOGLE_PHOTO_MISSING_CACHE_TTL_MS=900000


# ═════════════════════════════════════════════════════════════════════════════
# 3. LEGACY — direct Zoho Sheet ETL (import_sheets.py / Dockerfile.etl)
#
# Not read by the app and not started by docker-compose.yml. Keep these in the
# secret store only for rollback (see docs/ZOHO_FLOW_INTEGRATION.md). Also read
# by scripts/zoho_probe.py.
# ═════════════════════════════════════════════════════════════════════════════

# ── Zoho Sheet (ETL source) ─────────────────────────────────────────────────
# Mint these once from a Self Client at https://api-console.zoho.in
# (Add Client → Self Client → scope ZohoSheet.dataAPI.READ), then exchange the
# grant code for a refresh token. The refresh token does not expire, so the ETL
# container needs no mounted credentials and no writable filesystem.
#
# The data centre must match the account. An India account is only reachable on
# the .in hosts; the same call against .com returns 404, which reads like a bad
# resource id. Change BOTH urls together.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SHEET_API_URL=https://sheet.zoho.in/api/v2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# From the sheet URL: sheet.zoho.in/sheet/open/<THIS PART>
ZOHO_RESOURCE_ID=fym3rf908df9958f14c4c8c3593ae476cd81d
# The parsed tab. Raw_Messages holds unparsed Cliq chat text and is NOT usable.
SHEET_TAB=Collection_Data
# Optional tuning.
# ZOHO_PAGE_SIZE=1000
# ZOHO_TIMEOUT_SECONDS=60
# ZOHO_FETCH_CRITERIA=

# ── Message lifecycle ───────────────────────────────────────────────────────
# A collection can be edited or retracted after it is posted. Row identity comes
# from the message id, so an edit updates in place instead of inserting a second
# row and double-counting the agent's points.
# ZOHO_MESSAGE_ID_COLUMN=msg_id
# ZOHO_VERSION_STATUS_COLUMN=version_status
#
# Reconciliation hides rows deleted straight out of the sheet, which leave no
# version_status behind. Safe ONLY because Collection_Data keeps all history —
# set this false if the tab is ever rotated or archived, or it will hide every
# row the current sheet no longer covers.
# RECONCILE_MISSING_ROWS=true
# Refuse to reconcile when the sheet returns less than this share of the live DB
# rows. Guards against a partial fetch being read as a mass deletion.
# RECONCILE_MIN_RATIO=0.8
# Log what reconciliation would hide without changing anything. Worth running
# true for the first few production cycles.
# RECONCILE_DRY_RUN=false

# ── ETL loop ────────────────────────────────────────────────────────────────
IMPORT_INTERVAL_SECONDS=60
